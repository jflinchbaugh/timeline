{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        org.clojure/clojurescript {:mvn/version "1.12.134"}
        thheller/shadow-cljs {:mvn/version "3.3.6"}
        lilactown/helix {:mvn/version "0.2.2"}
        cljs-ajax/cljs-ajax {:mvn/version "0.8.4"}}
 :aliases
 {:run-m {:main-opts ["-m" "com.hjsoft.timeline"]}
  :run-x {:ns-default com.hjsoft.timeline
          :exec-fn greet
          :exec-args {:name "Clojure"}}
  :build {:deps {io.github.clojure/tools.build
                 {:mvn/version "0.10.13"}}
          :ns-default build}
  :dev {:extra-deps {cider/cider-nrepl {:mvn/version "0.58.0"}
                     refactor-nrepl/refactor-nrepl {:mvn/version "3.11.0"}}}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.3"}
                      io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
