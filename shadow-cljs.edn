{:deps {:aliases [:test]}
 :dev-http {8080 ["target/public"]
            8021 "target/public/test"}
 :builds
 {:app {:target :browser
       :output-dir "target/public/js"
       :asset-path "/js"
       :modules {:main {:init-fn com.hjsoft.timeline.core/init!}}
       :devtools {:after-load com.hjsoft.timeline.core/reload!}
       :build-hooks [(com.hjsoft.timeline.build-hooks/copy-resources)]}

  :test {:target :browser-test
         :test-dir "target/public/test"}
  :node-test {:target :node-test
              :output-to "out/tests.js"
              :main com.hjsoft.timeline.test-runner/main
              :autorun true}}}
